<panel id="screen"><text id="heading">JOIN KITCHEN</text><text id="description">Browser co-op uses room codes. Keep the host tab open.</text><panel id="mainEntries"><text class="detail">Enter a room code or paste an invitation link.</text><input class="textInput" bind="address" onchange="OnAddressChanged" /><button onclick="OnPasteRoom">ENTER ROOM CODE</button><button class="primary" onclick="OnJoin">JOIN BROWSER ROOM</button><button onclick="OnBack">BACK</button></panel><text id="notice" bind="notice" /></panel>