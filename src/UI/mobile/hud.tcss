#hud { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none }
#orderBar { position: absolute; left: 16; top: 16; width: 790; height: 160 }
.ticket { position: absolute; top: 0; width: 180; height: 150; padding: 8; background-color: #fff4e6ee; border-radius: 6 }
#order0 { left: 0 }
#order1 { left: 192 }
#order2 { left: 384 }
#order3 { left: 576 }
.customerNumber { font-size: 18; height: 24; color: #8a391e }
.ticketText { font-size: 22; height: 115; white-space: normal; color: #2e1d0f }
#scorePanel { position: absolute; right: 16; top: 16; width: 190; padding: 12; gap: 4; background-color: #10202bee; border-radius: 6 }
#scoreValue { font-size: 26; height: 30; color: #fff4e6 }
#clockValue { font-size: 34; height: 38; color: #ffcf76 }
#comboValue { font-size: 22; height: 26; color: #ff9f62 }
#actionPrompt { position: absolute; left: 250; right: 250; bottom: 10; width: auto; height: 70; padding: 6; background-color: #10202bd0; border-radius: 6 }
#promptText { font-size: 22; height: 30; white-space: normal; color: #fff4e6 }
#stationPrompt { font-size: 22; height: 30; white-space: normal; color: #ffcf76 }
@media (max-aspect-ratio: 1.5) {
 .ticket { width: 156; height: 156 }
 .ticketText { font-size: 20; height: 120 }
 #order1 { left: 168 }
 #order2 { left: 336 }
 #order3 { left: 504 }
 #scorePanel { top: 180; width: 160 }
 #actionPrompt { left: 16; right: 16; bottom: 340; height: 100 }
 #promptText, #stationPrompt { height: 44 }
}
