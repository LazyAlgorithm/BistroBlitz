#screen { position: absolute; left: 0; top: 0; width: 100%; height: 100% }
.backdrop { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #12100df6 }
.previewBackdrop { position: absolute; left: 0; top: 0; width: 55%; height: 100%; background-color: #12100df0 }
#topline { position: absolute; left: 0; top: 0; width: 100%; height: 4; background-color: #e06030 }
#brand { position: absolute; left: 88; top: 40; font-size: 26; color: #ffebcc }
#connection { position: absolute; right: 88; top: 44; width: 900; text-align: right; font-size: 18; color: #c4ab80 }
#divider { position: absolute; left: 88; top: 96; width: 1744; height: 1; background-color: #ffffff20 }
#heading { position: absolute; left: 88; top: 140; font-size: 96; height: 210; color: #fff5e6 }
#description { position: absolute; left: 92; top: 360; font-size: 22; height: 36; color: #d6be9c }
#footerline { position: absolute; left: 88; bottom: 85; width: 1744; height: 1; background-color: #ffffff20 }
#notice { position: absolute; left: 88; bottom: 32; width: 1300; height: 32; font-size: 21; color: #ffc97a }
#version { position: absolute; right: 88; bottom: 34; width: 450; text-align: right; font-size: 17; color: #8c7b64 }

#mainEntries { position: absolute; left: 92; top: 410; width: 460; gap: 8 }
button { width: 420; height: 50; font-size: 22; padding: 12 24; text-align: left; color: #fff8f0; background-color: #2b221b; border-width: 1; border-color: #614a38; border-radius: 4 }
button:hover { background-color: #423225; border-color: #d18d45; color: #ffffff }
.primary { background-color: #d64f2a; border-color: #ff7b47; color: #ffffff }
.primary:hover { background-color: #ea5f35; border-color: #ffa17a }
.quiet { background-color: #ffffff0a; border-color: #ffffff20 }
.quiet:hover { background-color: #ffffff18 }

.surface { background-color: #1e1713e8; border-width: 1; border-color: #61483366; border-radius: 6; padding: 28; gap: 16 }
.section { font-size: 26; color: #ffebcc; height: 36 }
.value { font-size: 32; color: #ffdc73; height: 44 }
.accent { font-size: 24; color: #ff914d; height: 34 }
.body { font-size: 20; color: #e0d0be; height: 32 }
.small { font-size: 17; color: #9c8a74; height: 26 }
.label { font-size: 18; color: #b8a38a; height: 28 }

#resultsPanel { position: absolute; right: 120; top: 240; width: 620; height: 320 }

#resultsPanel { left: 460; top: 220; width: 1000; height: 500 }

.body, #description, .ticketText { white-space: normal }
